*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs

# Rider / VS Code
.idea/
.vscode/

#################################
# ASP.NET CORE
#################################

# App settings (keep base file only)
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.Staging.json
**/appsettings.Production.json

# Optional safer pattern
# **/appsettings.*.json
# !**/appsettings.json

# Web publish output
**/wwwroot/

