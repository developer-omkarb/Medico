#################################
# ANGULAR / NODE
#################################

# Node dependencies
**/node_modules/

# Angular build output
**/dist/
**/out-tsc/
**/tmp/
**/.angular/

# Angular / Node env files
**/.env
**/.env.*
!**/.env.example

# Package locks (choose your preference)
package-lock.json
yarn.lock

# Angular cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

