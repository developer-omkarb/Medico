{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*","/assets/*","/images/*","/favicon.ico"]
  },
  "routes": [],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "globalHeaders": {
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff"
  }
}
